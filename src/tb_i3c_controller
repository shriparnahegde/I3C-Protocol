`timescale 1ns/1ps

module tb_i3c_controller;

reg clk;
reg rst_n;
reg start_daa;
reg start_tx;
reg [7:0] target_addr;
reg [7:0] tx_data_in;

wire [7:0] last_rx_data;
wire daa_complete;
wire tx_complete;

// BUS WIRES
wire scl;
wire sda;

// INTERNAL PAD SIGNALS
wire scl_o, scl_oe, scl_i;
wire sda_o, sda_oe, sda_i;


// ======================================================
// DUT 
// ======================================================

// PAD WRAPPER
i3c_pad_wrapper pads(
 .scl_o(scl_o),
 .scl_oe(scl_oe),
 .scl_i(scl_i),
 .scl(scl),

 .sda_o(sda_o),
 .sda_oe(sda_oe),
 .sda_i(sda_i),
 .sda(sda)
);

// CONTROLLER
i3c_controller dut(
 .clk(clk),
 .rst_n(rst_n),
 .start_daa(start_daa),
 .start_tx(start_tx),
 .target_addr(target_addr),
 .tx_data_in(tx_data_in),
 .daa_complete(daa_complete),
 .tx_complete(tx_complete),
 .last_rx_data(last_rx_data),
 .scl_o(scl_o),
 .scl_oe(scl_oe),
 .scl_i(scl_i),
 .sda_o(sda_o),
 .sda_oe(sda_oe),
 .sda_i(sda_i)
);


// ======================================================
// PULLUPS (Open Drain Bus)
// ======================================================
pullup(scl);
pullup(sda);


// ======================================================
// CLOCK
// ======================================================
initial begin
 clk=0;
 forever #5 clk=~clk;
end


// ======================================================
//  SLAVE ACK MODEL 
// ======================================================
reg slave_drive_sda;
assign sda = slave_drive_sda ? 1'b0 : 1'bz;

reg scl_d, sda_d;
reg [3:0] bit_counter;
reg in_transfer;

always @(posedge clk or negedge rst_n) begin
 if(!rst_n) begin
   slave_drive_sda <= 0;
   bit_counter     <= 0;
   in_transfer     <= 0;
   scl_d           <= 1;
   sda_d           <= 1;
 end else begin

   scl_d <= scl;
   sda_d <= sda;

   // START detect
   if(sda_d==1 && sda==0 && scl==1) begin
      in_transfer <= 1;
      bit_counter <= 0;
   end

   // STOP detect
   if(sda_d==0 && sda==1 && scl==1) begin
      in_transfer <= 0;
      bit_counter <= 0;
      slave_drive_sda <= 0;
   end

   // BIT counting
   if(in_transfer && !scl_d && scl) begin
      bit_counter <= bit_counter + 1;

      if(bit_counter == 7)
         slave_drive_sda <= 1;
      else
         slave_drive_sda <= 0;

      if(bit_counter == 9)
         bit_counter <= 0;
   end
 end
end


// ======================================================
// STIMULUS (UNCHANGED)
// ======================================================
initial begin
 $dumpfile("dump.vcd");
 $dumpvars(0,tb_i3c_controller);

 rst_n=0;
 start_daa=0;
 start_tx=0;
 target_addr=8'h08;
 tx_data_in=8'hA5;

 #200 rst_n=1;
 #1000;

 fork
   begin
     #2000000;
     $display("TIME: %0t | FATAL: Simulation Timeout!",$time);
     $finish;
   end
 join_none

 // DAA
 $display("TIME: %0t | Starting DAA Phase...",$time);
 @(posedge clk);
 start_daa=1;
 @(posedge clk);
 start_daa=0;

 wait(daa_complete);
 $display("TIME: %0t | DAA Phase Complete!",$time);

 #2000;

 // SDR WRITE
 $display("TIME: %0t | Starting SDR Private Write...",$time);
 @(posedge clk);
 start_tx=1;
 @(posedge clk);
 start_tx=0;

 wait(tx_complete);
 $display("TIME: %0t | SUCCESS: Transaction Finished!",$time);

 #5000;
 $finish;
end

endmodule
